# Supabase project (local development and Vercel use the same project).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Shown in the UI and printed reports.
NEXT_PUBLIC_APP_NAME=Inventaria

# Random string of at least 16 characters. It must match the value set in Vercel
# so the daily keep-alive cron can authenticate.
CRON_SECRET=
